{
  "name": "cinehub",
  "private": true,
  "version": "2.0.0",
  "description": "CineHub — organiza planes de cine con tus amigos (React + Vite).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:tmdb": "node --env-file=.env --test scripts/tmdb-live.mjs",
    "catalog:snapshot": "node --env-file=.env scripts/catalog-snapshot.mjs",
    "eas-build-post-install": "vite build && cap sync android",
    "apk": "eas build -p android --profile preview"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@supabase/supabase-js": "^2.117.2",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "supabase": "^2.118.0",
    "vite": "^8.3.1"
  }
}
