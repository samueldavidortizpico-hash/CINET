# CineHub — copia este archivo como .env y pega tu token de lectura de TMDB (v4).
# https://www.themoviedb.org/settings/api  →  "API Read Access Token"
# Sin token la app usa el catálogo local. VITE_* queda dentro del bundle:
# no despliegues un build con token; en producción usa un proxy/backend.
VITE_TMDB_READ_TOKEN=
VITE_TMDB_API_URL=https://api.themoviedb.org/3

# Supabase — pega los valores en .env.local (Project Settings → API).
# Solo la clave publicable; nunca service_role ni Secret Keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
