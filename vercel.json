{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/og.js": { "includeFiles": "dist/index.html" }
  },
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/tmdb/:path*", "destination": "/api/tmdb?path=:path*" },
    { "source": "/movie/:id", "destination": "/api/og?path=/movie/:id" },
    { "source": "/plan/:id", "destination": "/api/og?path=/plan/:id" },
    { "source": "/invite/:token", "destination": "/api/og?path=/invite/:token" },
    { "source": "/duo/sala/:code", "destination": "/api/og?path=/duo/sala/:code" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
